{
  "name": "smartflow-nlex-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "SmartFlow NLEX desktop dashboard built with Next.js, TypeScript, and Electron.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:desktop": "concurrently \"next dev -p 3002\" \"wait-on http://127.0.0.1:3002 && electron .\"",
    "dev:web": "next dev -p 3002",
    "build": "next build",
    "dist": "npm run build && electron-builder --win nsis",
    "start": "npx serve@latest out -l 3002",
    "start:desktop": "concurrently \"npx serve@latest out -l 3002\" \"wait-on http://127.0.0.1:3002 && electron .\"",
    "lint": "next lint"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.14.0",
    "mapbox-gl": "^3.23.0",
    "next": "^15.2.4",
    "pg": "^8.20.0",
    "postcss": "^8.5.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.2.4",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  }
}
