# Copy to Back-End/.env and fill in. NEVER commit the filled-in .env —
# these are real server-side secrets, not public values.
# Ask a teammate for the current values over a private channel.

PORT=4000
# Browser origins allowed to call the API, comma-separated. Native mobile does
# not need to be listed (a React Native fetch sends no Origin); add a port here
# only for an Expo *web* build or a second dashboard port.
# e.g. FRONTEND_ORIGIN=http://localhost:3002,http://localhost:8081
FRONTEND_ORIGIN=http://localhost:3002

# ── AWS RDS PostgreSQL ───────────────────────────────────────────────
# Either set POSTGRES_URL directly, or leave it blank and fill in the PG_*
# parts — config/env.ts assembles the URL and percent-encodes the password,
# which matters because these passwords contain URL-structural characters.
# Leave everything blank to run without a database: services fall back to
# mock data instead of failing.
POSTGRES_URL=

PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# RDS requires TLS but presents a regional CA that Node does not ship in its
# trust store, so strict verification fails against a genuine server.
#   relaxed = encrypt, skip chain verification (works out of the box)
#   verify  = full verification, requires PG_CA_CERT below
#   disable = no TLS (local Postgres only; RDS refuses it)
PG_SSL_MODE=relaxed
# Download from https://truststore.pki.rds.amazonaws.com/<region>/<region>-bundle.pem
# PG_CA_CERT=./certs/ap-southeast-1-bundle.pem

# ── Upstash Redis (live Waze feed for the map tab) ───────────────────
REDIS_REST_URL=
REDIS_REST_TOKEN=

# ── Supabase (audit-log + ai-sandbox auth) ──────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Climatiq emissions API ──────────────────────────────────────────
CLIMATIQ_API_KEY=
