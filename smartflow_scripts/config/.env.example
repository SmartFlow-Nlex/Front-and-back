# Copy this file to config/.env and fill it in. config/.env is gitignored and
# left out of the zip; never commit or upload it.

# ── Database (AWS RDS Postgres) ──────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=nlex_capstone
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# ── Data that lives outside this folder ──────────────────────────────────────
# The four hourly toll CSVs: nlex_traffic_hourly_2022.csv ... _2025.csv
RAW_TRAFFIC_DIR=
# Stalled-vehicle incident reports
INCIDENTS_CSV=
# Where the MODEL_EVALUATION_REPORT run folders are written
REPORTS_DIR=

# The group manuscript PDF (used by 7_utilities/manuscript_pdf)
MANUSCRIPT_PDF=

# ── APIs ─────────────────────────────────────────────────────────────────────
# Only used by 7_utilities/search_climatiq_pm.cjs
CLIMATIQ_API_KEY=
