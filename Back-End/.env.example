# Copy this file to `.env` and fill in the blanks, then `npm install && npm run dev`.
# `.env` is git-ignored — never commit real credentials.

# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3002

# --- PostgreSQL (shared RDS instance) ---
# src/config/db.ts reads POSTGRES_URL and forces SSL on, which RDS requires.
# Ask the team for the password; everything else below is the shared instance.
POSTGRES_URL=postgresql://postgres:<PASSWORD>@smartflow-db.choym2mcymec.ap-southeast-1.rds.amazonaws.com:5432/nlex_capstone

# Individual parts, used by the Python scripts in incident_model_scripts/
PG_HOST=smartflow-db.choym2mcymec.ap-southeast-1.rds.amazonaws.com
PG_PORT=5432
PG_DATABASE=nlex_capstone
PG_USER=postgres
PG_PASSWORD=

# --- Upstash Redis (live Waze cache for the map page; optional) ---
# Without these the map falls back to a static sample FeatureCollection.
REDIS_REST_URL=
REDIS_REST_TOKEN=

# --- Supabase (auth token validation in src/middleware/auth.middleware.ts) ---
# Optional locally: the middleware falls back to the project defaults baked
# into that file. Required if you point at a different Supabase project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional third-party ---
CLIMATIQ_API_KEY=
