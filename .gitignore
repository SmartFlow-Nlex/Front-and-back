node_modules
**/node_modules
.next
**/.next
out
**/out
dist
**/dist
coverage
**/coverage
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
# Env files.
# Committed:  Front-End-Dashboard/.env  — NEXT_PUBLIC_* values only. These are
#             compiled into the browser bundle and are public by definition, so
#             tracking them costs nothing and saves every teammate a setup step.
# Ignored:    anything holding real server-side secrets (DB URLs, API keys with
#             write access). Those are shared out-of-band, never committed.
.env*.local
Back-End/.env
Back-End/.env.*
!Back-End/.env.example

# Local backups taken before a merge — not part of the project.
.merge-backup/
# Scripts bundle: real credentials and local caches/logs are never committed.
smartflow_scripts/config/.env
smartflow_scripts/_work/cache/

# Python bytecode caches, anywhere in the repo (a stray one was committed under
# the sandbox scenarios' tools/ — see project_env_secrets.md). Compiled .pyc
# files are build artifacts, not secrets, but they don't belong in git either.
__pycache__/
**/__pycache__/
*.pyc

.env
**/.env
.env.example
**/.env.example
# The scripts' blank settings template holds no values, so teammates need it.
!smartflow_scripts/config/.env.example

# Dev-server logs written by start_project.bat / npm run dev.
*-dev.log
**/*-dev.log
