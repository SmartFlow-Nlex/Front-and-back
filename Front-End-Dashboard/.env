# Committed defaults for the SmartFlow NLEX dashboard.
# Next.js loads this automatically, so a fresh clone works with no setup.
#
# ONLY NEXT_PUBLIC_* values belong here. Next.js compiles these into the browser
# bundle, so they are visible to anyone who opens the app — putting a real secret
# in this file would publish it. Server-side secrets go in Back-End/.env (ignored).
#
# To override any value on your own machine, create .env.local — it is gitignored
# and takes precedence over this file.

# Mapbox GL public token (map-comparison tab).
# Restricted by URL in the Mapbox dashboard, which is what actually protects it.
NEXT_PUBLIC_MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# Express backend base URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Supabase project that issues the operator session tokens.
# The anon key is a PUBLIC key by Supabase's own design -- it is shipped to
# every browser and is protected by row-level security, not by secrecy. It
# lived as a hardcoded fallback in lib/supabase.ts, which meant the project
# in use was invisible in configuration and a misconfigured deployment
# silently authenticated against the development project. Declared here
# instead, where it can be read and changed.
NEXT_PUBLIC_SUPABASE_URL=https://qjbnilmopummgivymdiq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFqYm5pbG1vcHVtbWdpdnltZGlxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzNzAxNjYsImV4cCI6MjA5Nzk0NjE2Nn0.ue6leXwdj-dIFi5_TDWX7aCd4saywNOHG-UARLVOcvQ
