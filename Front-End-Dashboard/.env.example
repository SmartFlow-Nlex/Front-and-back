# Copy this file to `.env.local` (Next.js reads that name), then
# `npm install && npm run dev:web`. `.env.local` is git-ignored.

# --- Backend API the dashboard calls ---
# Every dashboard page falls back to this exact value if unset, so local work
# needs no change here.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# --- PostgreSQL (only used by lib/db.ts) ---
# Ask the team for the password. Same instance as the backend.
POSTGRES_URL=postgresql://postgres:<PASSWORD>@smartflow-db.choym2mcymec.ap-southeast-1.rds.amazonaws.com:5432/nlex_capstone

# --- Supabase (client auth) ---
# Optional: lib/supabase.ts falls back to the project defaults baked into it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mapbox (tiles on the map-comparison page) ---
# Leave blank and the map panel renders a "token required" placeholder; every
# other page is unaffected.
NEXT_PUBLIC_MAPBOX_TOKEN=
